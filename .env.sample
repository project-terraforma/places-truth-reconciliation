# API keys for DSPy model evaluation

# Anthropic (used for Haiku as upper-bound baseline before testing SLMs)
ANTHROPIC_API_KEY=your-key-here

# Together AI — runs open-source SLMs via API (cheap, no local GPU needed)
# Sign up at https://api.together.xyz — free $25 credit on signup
# Mistral-7B costs ~$0.20/1M tokens
TOGETHER_API_KEY=your-key-here

# Groq — runs Llama-3.1-8B free tier (rate-limited but free)
# Sign up at https://console.groq.com
GROQ_API_KEY=your-key-here

# Ollama — local inference, no key needed (see README for setup)
# Install: brew install ollama
# Pull model: ollama pull mistral
# Then use: python 11_dspy_extra_content.py --provider ollama --model mistral
